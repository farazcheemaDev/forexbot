# ---------------------------------------------------------------- python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ------------------------------------------------------------------ data ----
# 1.3 GB of cached market data: Binance klines, the 203 delisted-coin archive,
# and the Polymarket market cache. All of it is REGENERABLE - every fetch()
# rebuilds its own cache on first use - and GitHub rejects files over 100 MB.
# Keeping it out is what makes this repo cloneable onto a 1 GB VM.
strategy_analysis/data/

# ------------------------------------------------------------- run state ----
# Machine-specific. A VPS that cloned these would resume from THIS machine's
# open positions and single-instance locks, which is wrong in both directions.
logs/*_state.json
logs/*.pid
logs/*.tmp

# Log text is noisy and regenerates itself; the CSVs below are the actual record.
logs/*.log

# KEEP, explicitly - these are results, not artifacts:
!logs/trades_*.csv
!logs/poly_snapshots.csv

# ---------------------------------------------------------------- secrets ----
# Nothing here holds credentials today (Bitget keys come from environment
# variables and config.yaml carries only placeholders), and this list exists so
# that stays true by accident as well as by intent.
*.pem
*.key
*.ppk
.env
.env.*
secrets.yaml
credentials.json

# ------------------------------------------------------------------- os ----
Thumbs.db
.DS_Store
desktop.ini

# Process stdout capture from nohup/Start-Process launches — pure noise, and it
# churns on every bot cycle.
logs/*.out
logs/*.err

# Dry-run state and trade files. A dry run now keeps its own copies so it cannot
# race the live bot on logs/longtrend_state.json — see longtrend_bot.main().
logs/*.dryrun.*

# pulled account history - real trade data, keep local until reviewed
strategy_analysis/mt5_history.csv

# official broker statement - contains a real name and account number
strategy_analysis/statement_raw.txt
strategy_analysis/statement_trades.csv

# The combination paper book's live record (combo_paper.py) is machine-local, like the state
# files. A committed copy would be restored over a live book by the VM's `git reset --hard`.
logs/combo_*.csv
logs/trades_combo_trend.csv
# blend_paper's extra books name their state blend_state_<book>.json, which *_state.json
# does not match (CLAUDE.md section 10 housekeeping note).
logs/blend_state*.json

# The local combo_paper run that preceded the VM (2026-09-24 07:12-12:45 UTC), archived.
logs/combo_local_stopped_*/

# combo_bot.py runs (demo / dry / live) keep their state, logs and execution records here.
# Machine-local: a committed copy would be restored over a live bot by `git reset --hard`.
logs/combo_bot_*/

# The crash-bid paper book's live record (wick_paper.py) is machine-local, like the state
# files: a committed copy would be restored over the VM's record by git reset --hard.
logs/wickp_*.csv
