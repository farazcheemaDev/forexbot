[Unit]
Description=Bitget DEMO order-path test - combo_bot.py --mode demo --wick (sized as $221, no real funds)
After=network-online.target
Wants=network-online.target
# This bot PLACES ORDERS, so a restart loop is not harmless the way it is for the paper books:
# if it fails three times in ten minutes it stays down and waits for a human.
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APP_DIR__

# ONE ACCOUNT, ONE BOT. This replaces the demo bot on the PC; it must never run beside it.
# combo_bot.guard_one_bot can see other bots on THIS machine only.

# CREDENTIALS COME FROM A ROOT-OWNED FILE, NOT FROM THIS UNIT (deploy/set_bitget_keys.sh).
# /etc/forexbot.env is chmod 600 root:root and is NOT in git. Bitget's demo uses the same key
# as live trading, so the key must be IP-whitelisted to this VM and have no withdrawal right;
# ALLOW_REAL = False in combo_bot.py is the second layer, not the first.
EnvironmentFile=/etc/forexbot.env

ExecStart=__APP_DIR__/.venv/bin/python -u combo_bot.py --mode demo --wick
Restart=on-failure
RestartSec=120

StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=__APP_DIR__/logs

[Install]
WantedBy=multi-user.target
