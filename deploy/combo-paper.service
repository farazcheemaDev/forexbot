[Unit]
Description=Combination paper book - triple + 21d anchor, market-neutral 1x, bear breadth sleeve 1x
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APP_DIR__
ExecStart=__APP_DIR__/.venv/bin/python -u combo_paper.py
# ONE INSTANCE ONLY. It started on the local PC on 2026-09-24. Enable this on the VM only after
# stopping the local copy, and copy logs/combo_state.json + logs/combo_*.csv across first, or
# the VM starts a fresh record and the test's clock restarts.
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal
# It places NO orders anywhere; it reads Binance public endpoints only and needs no keys.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=__APP_DIR__/logs

[Install]
WantedBy=multi-user.target
