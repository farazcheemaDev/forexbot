[Unit]
Description=Combination paper book - triple + 21d anchor, market-neutral 1x, bear breadth sleeve 1x
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APP_DIR__
ExecStart=__APP_DIR__/.venv/bin/python -u combo_paper.py
# ONE INSTANCE ONLY. Runs on the VM since 2026-09-24 12:40 UTC (installed by
# deploy/install_combo.sh). Never start a second copy anywhere else: two copies are two
# records, and the pre-registered verdict needs exactly one.
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal
# It places NO orders anywhere; it reads Binance public endpoints only and needs no keys.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=__APP_DIR__/logs

[Install]
WantedBy=multi-user.target
